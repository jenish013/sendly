PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/sendly
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

STORAGE_PROVIDER=local
STORAGE_BUCKET=sendly-uploads
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Email provider: smtp | resend | sendgrid
# Choose one and fill in the corresponding credentials below

# SMTP configuration (for Gmail, Outlook, custom SMTP servers)
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-password-or-smtp-password
EMAIL_FROM=SENDLY <no-reply@sendly.com>

# Resend API key (alternative to SMTP - set EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid API key (alternative to SMTP - set EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# EmailJS (alternative to SMTP - set EMAIL_PROVIDER=emailjs)
# Sent server-side via @emailjs/nodejs using the Private Key, so credentials
# never reach the frontend. The template's "To Email" field (Template > Settings
# tab in the EmailJS dashboard) must be set to {{to_email}} for delivery to work.
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key

# Base URL for email links - overridden by publicOrigin from frontend
# This is used as fallback when publicOrigin is not provided
TRANSFER_BASE_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
MAX_FILE_SIZE=10737418240
MAX_FILES_PER_TRANSFER=10
