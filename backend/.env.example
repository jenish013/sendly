PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/sendly
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

STORAGE_PROVIDER=local
STORAGE_BUCKET=sendly-uploads
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=SENDLY <no-reply@sendly.com>

TRANSFER_BASE_URL=http://localhost:5000
MAX_FILE_SIZE=10737418240
MAX_FILES_PER_TRANSFER=10
